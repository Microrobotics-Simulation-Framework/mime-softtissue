{
  "include": ["src", "tests/assert_types.py"],
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "reportMissingTypeStubs": false,
  "venvPath": ".",
  "venv": ".venv",
  // Strict, minus the six rules that fire on JAX's partially unknown signatures (jnp calls, jax.lax loops and the untyped
  // closures that feed them): 1043 of the 1093 errors on main were these, none of them a defect in this package's own types.
  // Every other strict rule stays on, and the 50 real errors it reported are fixed.
  "reportUnknownArgumentType": false,
  "reportUnknownMemberType": false,
  "reportUnknownVariableType": false,
  "reportUnknownParameterType": false,
  "reportUnknownLambdaType": false,
  "reportMissingParameterType": false
}
